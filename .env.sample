# Standard PostgreSQL / Netlify Database connection string.
# Both of these forms are supported (TLS query parameters are normalized):
#   postgresql://user:password@host:5432/dbname?sslmode=require
#   postgresql://user:password@host:5432/dbname?uselibpqcompat=true&sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# On Netlify, NETLIFY_DB_URL is injected automatically and used as a fallback.

# Optional connection overrides:
# DB_CONNECTOR=pg                 # pg (default) or netlify
# DATABASE_SSL_MODE=require       # disable | require | no-verify | verify-ca | verify-full
# DATABASE_SSL_CA=/path/to/ca.pem # CA bundle for verify-ca / verify-full
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000

ADMIN_PASSWORD=spinmaster
